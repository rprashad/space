# Powerline ribbon; metrics describe the Linux instance.
typeset -g POWERLEVEL9K_MODE=powerline
typeset -g POWERLEVEL9K_LEFT_PROMPT_ELEMENTS=(dir vcs)
typeset -g POWERLEVEL9K_RIGHT_PROMPT_ELEMENTS=(ip load ram time)
typeset -g POWERLEVEL9K_PROMPT_ON_NEWLINE=true
typeset -g POWERLEVEL9K_PROMPT_ADD_NEWLINE=true
typeset -g POWERLEVEL9K_LEFT_SEGMENT_SEPARATOR=$'\uE0B0'
typeset -g POWERLEVEL9K_RIGHT_SEGMENT_SEPARATOR=$'\uE0B2'
typeset -g POWERLEVEL9K_DIR_BACKGROUND=153
typeset -g POWERLEVEL9K_DIR_FOREGROUND=17
typeset -g POWERLEVEL9K_VCS_CLEAN_BACKGROUND=151
typeset -g POWERLEVEL9K_VCS_UNTRACKED_BACKGROUND=222
typeset -g POWERLEVEL9K_VCS_MODIFIED_BACKGROUND=217
typeset -g POWERLEVEL9K_VCS_CLEAN_FOREGROUND=17
typeset -g POWERLEVEL9K_VCS_UNTRACKED_FOREGROUND=17
typeset -g POWERLEVEL9K_VCS_MODIFIED_FOREGROUND=17
# First active Ethernet/Wi-Fi interface (Linux, WSL, or macOS); hidden when offline.
# Resolve locally through Powerlevel10k rather than storing a machine-specific address.
typeset -g POWERLEVEL9K_IP_INTERFACE='(en|eth|wl|ww).*'
typeset -g POWERLEVEL9K_IP_CONTENT_EXPANSION='$P9K_IP_IP'
typeset -g POWERLEVEL9K_IP_BACKGROUND=110
typeset -g POWERLEVEL9K_IP_FOREGROUND=17
typeset -g POWERLEVEL9K_LOAD_BACKGROUND=147
typeset -g POWERLEVEL9K_LOAD_FOREGROUND=17
typeset -g POWERLEVEL9K_RAM_BACKGROUND=116
typeset -g POWERLEVEL9K_RAM_FOREGROUND=17
typeset -g POWERLEVEL9K_TIME_BACKGROUND=153
typeset -g POWERLEVEL9K_TIME_FOREGROUND=17
typeset -g POWERLEVEL9K_TIME_FORMAT='%D{%H:%M}'
typeset -g POWERLEVEL9K_DISABLE_CONFIGURATION_WIZARD=true
